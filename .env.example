POSTGRES_DB=sykra
POSTGRES_USER=sykra
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://sykra:replace-with-a-long-random-password@localhost:5432/sykra
SECURE_COOKIES=false
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Private local upload root; production should use a private object-storage adapter.
STORAGE_ROOT=./uploads
# Set true only when the local ClamAV service is available; enabled mode fails closed.
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Development uses console logging; production can use resend after account setup.
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=
FRONTEND_PUBLIC_URL=http://localhost:3000
HIBP_CHECK_ENABLED=true
